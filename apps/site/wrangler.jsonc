{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The site: static assets only, no Worker code.
  "name": "sillon-site",
  "account_id": "a91c4ce97401e1568c64669c9c96ac95",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // One canonical address: no workers.dev URL and no preview URLs.
  "routes": [{ "pattern": "sillon.mattrothenberg.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
