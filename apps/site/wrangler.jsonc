{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The site: static assets, plus a small script for /audio/* that answers byte
  // ranges, which audio needs to start playing and to seek (worker/index.js).
  "name": "sillon-site",
  "main": "worker/index.js",
  "account_id": "a91c4ce97401e1568c64669c9c96ac95",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"]
  },
  // Production at sillon.mattrothenberg.com; each branch's Preview at
  // <branch>.sillon.mattrothenberg.com (`wrangler preview`). Nothing on workers.dev.
  "routes": [{ "pattern": "sillon.mattrothenberg.com", "custom_domain": true, "previews_enabled": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Previews use the same assets and script as production; nothing to override.
  "previews": {},
  "observability": { "enabled": true }
}
