---
import Page from '../layouts/Page.astro'
import { markSvg } from '../lib/mark'
import { readFileSync, statSync } from 'node:fs'
import { Peaks } from '@sillon/core'
import { highlight } from '../lib/highlight'
import {
  USAGE_JSX, VISUALIZER_JSX, REGIONS_JSX, ZOOM_JSX, COMMENTS_JSX, RECORD_JSX,
  THEMES, COMMENT, stylingJsx, type Theme,
} from '../snippets'
import pattern from '../../../../scripts/strudel/avril.strudel.js?raw'
import { HeroWave, NOTES } from '../islands/HeroWave'
import { hue } from '../islands/Comments'
import { shapeOf, silhouette } from '../lib/silhouette'
import { BARS } from '../shape'
import { formatTime } from '@sillon/react'
import { Rail, rail as railCls, railLead, railMark, railLabels, railWave, railEnd } from '../islands/Rail'
import { Parts } from '../islands/Parts'
import { Styling, type StylingCode } from '../islands/Styling'
import { Effects, type EffectsCode } from '../islands/Effects'
import { EFFECTS, effectJsx, VIS_LOOKS, type Effect, type VisLook } from '../effects'
import { Visualizer, type VisualizerCode } from '../islands/Visualizer'
import { Regions } from '../islands/Regions'
import { Comments } from '../islands/Comments'
import { Zoom } from '../islands/Zoom'
import { Recording } from '../islands/Recording'
import { Credit } from '../islands/Credit'
import { GITHUB_URL, githubMark } from '../lib/github'
import { avatar, chapterN, col, demoCode, face, lede, ledeText, ledeTitle, meta, pageEnd, pin, play, ring, section, transport } from '../cls'

const INSTALL = 'npm install @sillon/react'
const stylingCode = Object.fromEntries(
  (Object.keys(THEMES) as Theme[]).map((t) => [t, [highlight(stylingJsx(t), 'tsx')]]),
) as StylingCode
const visualizerCode = Object.fromEntries(
  (Object.keys(VIS_LOOKS) as VisLook[]).map((k) => [k, VIS_LOOKS[k].glsl
    ? [highlight(`<Visualizer player={player} fragment={${k}} />`, 'tsx'), highlight(VIS_LOOKS[k].glsl!, 'glsl')]
    : [highlight(VISUALIZER_JSX, 'tsx')]]),
) as VisualizerCode
const effectsCode = Object.fromEntries(
  (Object.keys(EFFECTS) as Effect[]).map((e) => [e, [highlight(effectJsx(e), 'tsx'), ...(EFFECTS[e].glsl ? [highlight(EFFECTS[e].glsl!, 'glsl')] : [])]]),
) as EffectsCode

// The Long files demo reads peaks made ahead of time; its copy compares the two sizes.
// The hour's MP3 isn't in the repo (57 MB), so its size is worked out from the peaks'
// duration at the 128 kbps it was encoded at (scripts/gen-audio.sh).
const hourPeaksPath = `${process.cwd()}/public/audio/hour.peaks`
const hourPeaksKB = Math.round(statSync(hourPeaksPath).size / 1024)
const hourSeconds = Peaks.decode(new Uint8Array(readFileSync(hourPeaksPath)).buffer).duration
const hourAudioMB = Math.round((hourSeconds * 128_000) / 8 / 1024 / 1024)

// The song's bars, drawn into the page at build time for the rail, at a desktop and a
// phone width; the island then draws the same bars from the same shape. The hero's bars
// fade in once its island draws them, so they appear once however late it loads.
const shape = shapeOf('/audio/avril.peaks')
const duration = (shape.values.length * shape.bucketSize) / shape.sampleRate
const RAIL = { height: 30, barWidth: 3, barGap: 2, barRadius: 1, align: 'bottom', contrast: 1 } as const
const sil = (g: typeof RAIL, width: number, bars: number) => ({ width, d: silhouette(shape, { ...g, width, bars }) })
const rail = [sil(RAIL, 978, BARS.rail.wide), sil(RAIL, 324, BARS.rail.narrow)]

// Numbered like the rail, which reads the same list off the page.
const n = (i: number) => String(i).padStart(2, '0')

const silSvg = 'size-full fill-track'
---
<Page title="sillon" description="Headless waveform components for React." page="home">
    <section class="pt-6 [--wave:clamp(150px,24vh,230px)]" aria-labelledby="hero-title">
      <HeroWave client:only="react" shape={shape}>
        <div slot="fallback" aria-hidden="true">
          {/* Holds the waveform's and the transport's space until the demo loads. */}
          <div class="relative h-(--wave)">
            {NOTES.map((n) => (
              <span class={pin} style={`position: absolute; top: 0; bottom: 0; left: ${((n.time / duration) * 100).toFixed(3)}%`}>
                <span class={`${face} ${COMMENT.face}`}><span class={`${avatar} ${ring.on}`} style={`--hue: ${hue(n.who)}`}>{n.who[0]}</span></span>
              </span>
            ))}
          </div>
          <div class={`${col} ${transport} mt-14`}>
            <span class={play}><svg viewBox="0 0 16 16" fill="currentColor"><path d="M4.5 2.6v10.8a.8.8 0 0 0 1.2.7l8.6-5.4a.8.8 0 0 0 0-1.4L5.7 1.9a.8.8 0 0 0-1.2.7z" /></svg></span>
            <span class={meta}><span>0:00</span> / {formatTime(duration)}</span>
          </div>
        </div>
      </HeroWave>
      <div class={col}>
        <Credit client:idle pattern={highlight(pattern, 'javascript')} />
      </div>
      <div class={`${col} mt-[72px] narrow:mt-14`}>
        <h1 id="hero-title" class="text-[40px]/[1.12] font-semibold tracking-[-0.02em] text-balance text-ink narrow:text-[32px]">Headless waveform components for React.</h1>
        <p class="mt-6 max-w-text text-[19px]/[1.55] text-ink-2 narrow:text-[17px]">Build waveforms from peaks, playback, regions, markers, and a visualizer. Style every part with your own CSS.</p>
        <div class="mt-8 flex flex-wrap items-stretch gap-3">
          <div class="flex w-fit max-w-full items-center justify-between gap-3 rounded-[10px] bg-plate py-2 pr-2 pl-4">
            <code class="overflow-x-auto text-[14px] whitespace-nowrap"><span class="text-ink-3" aria-hidden="true">$ </span>{INSTALL}</code>
            <button
              class="min-w-16 cursor-pointer rounded-[7px] border-0 bg-card px-2.5 py-1 font-mono text-[13px]/[1.5] text-ink-2 shadow-lift hover:text-ink"
              type="button"
              data-copy={INSTALL}
              aria-label="Copy install command"
            >Copy</button>
          </div>
          <a class="inline-flex items-center gap-2 rounded-[10px] border border-rule px-4 text-[15px] text-ink-2 no-underline hover:bg-plate hover:text-ink" href={GITHUB_URL}>
            <Fragment set:html={githubMark(17)} />
            GitHub
          </a>
        </div>
      </div>
    </section>

    {/* The page is a track. The song runs edge to edge at the top, then a rail of the
        same song stays pinned while you read: its regions are the sections below and
        the scroll position is its playhead. */}
    <div class="sticky top-0 z-20 mt-24 border-y border-rule bg-paper/90 backdrop-blur-[10px]" data-shot="rail">
      <Rail client:only="react" shape={shape}>
        <div slot="fallback" class={railCls} aria-hidden="true">
          <span class={railLead}><span class={railMark}><Fragment set:html={markSvg('mark-rail-ph', 22)} /></span></span>
          <div class="min-w-0">
            <div class={railLabels}></div>
            {/* The bars drawn at build time, shown until the island takes over with the same bars. */}
            <div class={railWave}>
              <svg class={`${silSvg} narrow:hidden`} viewBox={`0 0 ${rail[0].width} ${RAIL.height}`} preserveAspectRatio="none"><path d={rail[0].d} /></svg>
              <svg class={`${silSvg} hidden narrow:block`} viewBox={`0 0 ${rail[1].width} ${RAIL.height}`} preserveAspectRatio="none"><path d={rail[1].d} /></svg>
            </div>
          </div>
          <span class={railEnd}></span>
        </div>
      </Rail>
    </div>

    {/* No footer: pageEnd adds the space below the last section. */}
    {/* The rail's own rule divides the first section from the hero. */}
    <main class={`${col} ${pageEnd} [&>section:first-child]:mt-0 [&>section:first-child]:border-t-0`}>
      <section id="usage" class={section} data-chapter="Usage">
        <div class={lede}>
          <span class={chapterN}>{n(1)}</span>
          <h2 class={ledeTitle}>Usage</h2>
          <p class={ledeText}><code>useAudio</code> loads a file and returns peaks and a player. Pass both to <code>Waveform.Root</code>, then add the parts you need.</p>
        </div>
        <div data-code set:html={highlight(USAGE_JSX, 'tsx')} />
        <p class="mt-5 mb-8 max-w-text text-ink-2 [&_code]:text-ink">
          To read a <code>.peaks</code> file, or to draw a waveform with no playback, use <code>usePeaks</code> and <code>usePlayer</code> separately.
          The waveform appears once the whole file is read; pass <code>progressive</code> to draw it while a long file streams in.
        </p>
      </section>

      <section id="parts" class={section} data-chapter="Components">
        <div class={lede}>
          <span class={chapterN}>{n(2)}</span>
          <h2 class={ledeTitle}>Components</h2>
          <p class={ledeText}>A waveform has separate parts for bars, progress, the cursor, and time. Use the parts you need. The tiles below all play the same song.</p>
        </div>
        <Parts client:only="react"><div slot="fallback" style="height: 720px" aria-hidden="true"></div></Parts>
      </section>

      <section id="styling" class={section} data-chapter="Styling">
        <div class={lede}>
          <span class={chapterN}>{n(3)}</span>
          <h2 class={ledeTitle}>Styling</h2>
          <p class={ledeText}><code>Track</code> and <code>Progress</code> clip their backgrounds to the bars. Use a color, gradient, pattern, or image.</p>
        </div>
        <Styling client:only="react" code={stylingCode}><div slot="fallback" style="height: 560px" aria-hidden="true"></div></Styling>
      </section>

      <section id="effects" class={section} data-chapter="Effects">
        <div class={lede}>
          <span class={chapterN}>{n(4)}</span>
          <h2 class={ledeTitle}>Effects</h2>
          <p class={ledeText}><code>Waveform.GL</code> runs GLSL with each bar's height, the time since the playhead passed it, and the song's current loudness. The sparks and dust use the same data from <code>useWaveform()</code>. They start when you press play.</p>
        </div>
        <Effects client:only="react" code={effectsCode}><div slot="fallback" style="height: 560px" aria-hidden="true"></div></Effects>
      </section>

      <section id="visualizer" class={section} data-chapter="Visualizer">
        <div class={lede}>
          <span class={chapterN}>{n(5)}</span>
          <h2 class={ledeTitle}>Visualizer</h2>
          <p class={ledeText}><code>Visualizer</code> draws a player's spectrum while it plays. By default, it uses the element's CSS <code>color</code>, including in dark mode. Pass a <code>fragment</code> to draw with WebGL and your shader instead.</p>
        </div>
        <Visualizer client:only="react" code={visualizerCode}><div slot="fallback" style="height: 500px" aria-hidden="true"></div></Visualizer>
      </section>

      <section id="regions" class={section} data-chapter="Regions">
        <div class={lede}>
          <span class={chapterN}>{n(6)}</span>
          <h2 class={ledeTitle}>Regions</h2>
          <p class={ledeText}><code>Waveform.Region</code> marks a span of time. Drag across the waveform to mark a passage, then move it or pull its edges. <code>player.setLoop()</code> repeats it.</p>
        </div>
        <Regions client:only="react"><div slot="fallback" style="height: 230px" aria-hidden="true"></div></Regions>
        <div class={demoCode}><div data-code set:html={highlight(REGIONS_JSX, 'tsx')} /></div>
      </section>

      <section id="comments" class={section} data-chapter="Comments">
        <div class={lede}>
          <span class={chapterN}>{n(7)}</span>
          <h2 class={ledeTitle}>Comments</h2>
          <p class={ledeText}><code>Waveform.Marker</code> attaches any content to a time. <code>useGroups</code> combines markers that overlap, and <code>useActive</code> returns the item the playhead just passed. Click an avatar to play from its comment, or a number to see the comments at that point.</p>
        </div>
        <Comments client:only="react"><div slot="fallback" style="height: 300px" aria-hidden="true"></div></Comments>
        <div class={demoCode}><div data-code set:html={highlight(COMMENTS_JSX, 'tsx')} /></div>
      </section>

      <section id="zoom" class={section} data-chapter="Long files">
        <div class={lede}>
          <span class={chapterN}>{n(8)}</span>
          <h2 class={ledeTitle}>Long files</h2>
          <p class={ledeText}>This hour-long recording uses peaks prepared ahead of time: a {hourPeaksKB} kB <code>.peaks</code> file rather than {hourAudioMB} MB of audio. Pinch to zoom (Ctrl+scroll with a mouse); scroll sideways or drag to pan. <code>useZoom</code> handles those gestures, and <code>store.setView(start, end)</code> sets the visible range.</p>
          <p class={ledeText}><code>@sillon/core</code> contains the decoder and the <code>.peaks</code> format. It installs with <code>@sillon/react</code> but works without React too: create <code>.peaks</code> files with <code>Peaks.encode()</code>, or load them for your own drawing with <code>streamPeaks()</code>.</p>
        </div>
        <Zoom client:only="react"><div slot="fallback" style="height: 300px" aria-hidden="true"></div></Zoom>
        <div class={demoCode}><div data-code set:html={highlight(ZOOM_JSX, 'tsx')} /></div>
      </section>

      <section id="recording" class={section} data-chapter="Recording">
        <div class={lede}>
          <span class={chapterN}>{n(9)}</span>
          <h2 class={ledeTitle}>Recording</h2>
          <p class={ledeText}><code>useRecorder</code> records from the microphone and updates the peaks as you speak, so the waveform draws during recording. When you stop, it returns the audio for playback or upload and completes the peaks.</p>
        </div>
        <Recording client:only="react"><div slot="fallback" style="height: 190px" aria-hidden="true"></div></Recording>
        <div class={demoCode}><div data-code set:html={highlight(RECORD_JSX, 'tsx')} /></div>
      </section>
    </main>
</Page>
